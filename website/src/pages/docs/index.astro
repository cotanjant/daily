---
import SiteLayout from "../../layouts/SiteLayout.astro";

const docs = [
  { kind: "Start here", title: "Command guide", href: "https://github.com/cotanjant/daily/blob/main/docs/usage.md", text: "Examples for downloads, reminders, filesystem commands, and time tools." },
  { kind: "Project map", title: "Architecture", href: "https://github.com/cotanjant/daily/blob/main/docs/architecture.md", text: "How the Rust CLI and Astro website fit together." },
  { kind: "Overview", title: "README", href: "https://github.com/cotanjant/daily/blob/main/README.md", text: "Install the command and see example workflows." },
];
---

<SiteLayout title="Documentation" description="Guides and command documentation for the daily Rust CLI collection." current="docs">
  <section class="shell page-head">
    <p class="eyebrow">Documentation</p>
    <h1>Find your way around.</h1>
    <p>Start with the command guide, or read how the CLI and website fit together.</p>
  </section>
  <section class="shell doc-grid">
    {docs.map((doc) => (
      <a class="doc-card" href={doc.href}>
        <span class="eyebrow">{doc.kind}</span>
        <h2>{doc.title} ↗</h2>
        <p>{doc.text}</p>
      </a>
    ))}
  </section>
</SiteLayout>
